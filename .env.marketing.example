# demo = 无密钥交互演示；deerflow = 真实 GLM + DeerFlow 工具执行
MARKETING_RUNTIME=demo
MARKETING_PORT=18080
MARKETING_API_KEY=
# 请按你的 GLM 账户套餐填入模型名和完整 OpenAI-compatible base URL。
# 普通 API 与 Coding Plan 的入口可能不同，以账户控制台为准。
MARKETING_MODEL=glm-5
MARKETING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
MARKETING_RECURSION_LIMIT=80

# PPT：页面设计模型使用上面的 MARKETING_MODEL；图片与视觉服务单独配置。
MARKETING_PPT_CUSTOM_PAGES=6
MARKETING_PPT_PAGE_CALL_LIMIT=14
MARKETING_IMAGE_ENABLED=true
MARKETING_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MARKETING_IMAGE_API_KEY=
MARKETING_IMAGE_MODEL=doubao-seedream-5-0-flash-260915
MARKETING_IMAGE_SIZE=2048x1152
# 按账户实际价格配置；为 0 时不发送付费生图请求。
MARKETING_IMAGE_PRICE_RMB=0
MARKETING_IMAGE_MAX_REQUESTS=100
MARKETING_IMAGE_BUDGET_RMB=20
MARKETING_VISION_ENABLED=false
MARKETING_VISION_MODEL=doubao-seed-2-0-mini-260428
MARKETING_VISION_MAX_REQUESTS=64
# 图片与视觉共用的持久累计预留上限，不是每份 PPT 的额度；不含 GLM 调用。
MARKETING_PPT_BUDGET_RMB=20
